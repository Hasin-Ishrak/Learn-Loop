# DEV ONLY. Never commit a real packages/db/.env.
# Passwords must match infra/.env (and infra/.env.example).

# Runtime role (learnloop_app): used by db:check and by the server at runtime.
DATABASE_URL=postgresql://learnloop_app:learnloop_app_dev@localhost:5432/learnloop

# Schema/migration owner (learnloop_owner): used by drizzle-kit (generate/migrate/studio).
DATABASE_MIGRATION_URL=postgresql://learnloop_owner:learnloop_owner_dev@localhost:5432/learnloop
