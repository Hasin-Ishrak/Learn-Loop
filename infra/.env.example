# ---------------------------------------------------------------------------
# LearnLoop local development infrastructure - DEV ONLY
#
# These are throwaway local credentials. NEVER reuse them outside this machine
# and never commit a real infra/.env file.
#
# Copy this file once:
#   Copy-Item infra/.env.example infra/.env
# ---------------------------------------------------------------------------

# Bootstrap superuser password (role "postgres"). Used only for init scripts.
POSTGRES_PASSWORD=learnloop_dev_postgres

# Maintenance database created by the postgres image on first start.
POSTGRES_DB=postgres

# Schema/migration owner. Owns the databases, the public schema and every table.
LEARNLOOP_OWNER_PASSWORD=learnloop_owner_dev

# Runtime application role. Least privilege: no DDL, no RLS bypass, no superuser.
LEARNLOOP_APP_PASSWORD=learnloop_app_dev
