{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    // Vite needs ESNext + Bundler resolution and DOM libs; override the NodeNext
    // base config which targets a Node runtime. noEmit because Vite handles builds.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".output"]
}
