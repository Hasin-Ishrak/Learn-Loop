NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
# Runtime role (learnloop_app): least privilege, no DDL. Password must match
# LEARNLOOP_APP_PASSWORD in infra/.env (see infra/.env.example).
DATABASE_URL=postgresql://learnloop_app:learnloop_app_dev@localhost:5432/learnloop
# Migrations only. Uses the schema owner role (learnloop_owner); password must
# match LEARNLOOP_OWNER_PASSWORD in infra/.env. Not read by the app yet.
# DATABASE_MIGRATION_URL=postgresql://learnloop_owner:learnloop_owner_dev@localhost:5432/learnloop
REDIS_URL=redis://localhost:6379
