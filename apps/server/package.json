{
  "name": "@learnloop/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @learnloop/shared build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev:api": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "dev:scheduler": "nest start --watch --entryFile main.scheduler",
    "dev": "concurrently -k -n api,worker,scheduler -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:scheduler\"",
    "start:api": "node --enable-source-maps dist/main.api.js",
    "start:worker": "node --enable-source-maps dist/main.worker.js",
    "start:scheduler": "node --enable-source-maps dist/main.scheduler.js"
  },
  "dependencies": {
    "@learnloop/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@learnloop/config": "workspace:*",
    "@nestjs/cli": "^12.0.15",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
